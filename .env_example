# Domaine de base
DOMAIN_BASE=tpdocker.istic.univ-rennes1.fr

# Gitea
GITEA_HTTP_PORT=8083
GITEA_SSH_PORT=2222

# WordPress
WORDPRESS_HTTP1_PORT=8081
WORDPRESS_HTTP2_PORT=8087
WORDPRESS_DB_PORT=3306

# Nextcloud
NEXTCLOUD_HTTP_PORT=8080
NEXTCLOUD_DB_PORT=3307

# Syncthing
SYNCTHING_HTTP_PORT=8384
SYNCTHING_SYNC_TCP_PORT=22000
SYNCTHING_DISCOVERY_UDP_PORT=21027

# Trilium
TRILIUM_HTTP_PORT=8180

# Vaultwarden
VAULTWARDEN_HTTP_PORT=4044

# Wiki.js
WIKI_HTTP_PORT=8082

# Monitoring
GRAFANA_HTTP_PORT=3000
PROMETHEUS_HTTP_PORT=8086
NODE_EXPORTER_HTTP_PORT=8084
CADVISOR_HTTP_PORT=8085

# Mattermost
MATTERMOST_APP_PORT=8065
MATTERMOST_CALLS_PORT=8443
POSTGRES_IMAGE_TAG=15-alpine
RESTART_POLICY=unless-stopped
MATTERMOST_IMAGE=mattermost-enterprise-edition
MATTERMOST_IMAGE_TAG=latest
MATTERMOST_CONTAINER_READONLY=false
POSTGRES_DATA_PATH=./volumes/db/var/lib/postgresql/data
MATTERMOST_CONFIG_PATH=./volumes/app/mattermost/config
MATTERMOST_DATA_PATH=./volumes/app/mattermost/data
MATTERMOST_LOGS_PATH=./volumes/app/mattermost/logs
MATTERMOST_PLUGINS_PATH=./volumes/app/mattermost/plugins
MATTERMOST_CLIENT_PLUGINS_PATH=./volumes/app/mattermost/client/plugins
MATTERMOST_BLEVE_INDEXES_PATH=./volumes/app/mattermost/bleve-indexes
MM_SQLSETTINGS_DRIVERNAME=postgres
MM_SQLSETTINGS_DATASOURCE=postgres://mmuser:mostest@postgres:5432/mattermost?sslmode=disable&connect_timeout=10
MM_BLEVESETTINGS_INDEXDIR=/mattermost/bleve-indexes
MM_SERVICESETTINGS_SITEURL=http://mattermost.${DOMAIN_BASE}

